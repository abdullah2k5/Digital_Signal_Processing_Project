                 'DATA MISSING', 'Clear', 'Clear', 'Clear', 'STOLEN - FIR REPORTED'} ...
    );

    % --- DESIGN THEME (Cyber-Tech Dark Mode) ---
    mainBg = [0.05 0.07 0.10];    
    panelBg = [0.10 0.12 0.18];   
    accentCyan = [0.00 1.00 0.80]; 
    textGrey = [0.75 0.75 0.75];

    fig = uifigure('Name', 'PREMIUM NEURAL SCANNER V4.0', 'Color', mainBg, 'Position', [100 100 1050 720]);

    % Header Panel
    header = uipanel(fig, 'BackgroundColor', [0.02 0.03 0.05], 'Position', [0 640 1050 80], 'BorderType', 'none');
    uilabel(header, 'Text', 'SYSTEM: ADVANCED PLATE DECRYPTION', 'FontSize', 32, 'FontWeight', 'bold', 'Position', [40 25 700 45], 'FontColor', [1 1 1]);
    
    % LEFT Side: Optical Scanner
    leftPanel = uipanel(fig, 'Title', 'OPTICAL FEED', 'Position', [40 40 460 580], 'BackgroundColor', panelBg, 'ForegroundColor', accentCyan, 'FontWeight', 'bold');
    ax = uiaxes(leftPanel, 'Position', [20 300 420 250], 'BackgroundColor', [0 0 0], 'XColor', 'none', 'YColor', 'none');
    uilabel(leftPanel, 'Text', 'INPUT REGISTRATION NUMBER:', 'Position', [30 230 300 22], 'FontColor', [1 1 1], 'FontWeight', 'bold');
    searchField = uieditfield(leftPanel, 'text', 'Position', [30 170 400 50], 'BackgroundColor', [0.15 0.20 0.30], 'FontColor', [1 1 1], 'FontSize', 24, 'HorizontalAlignment', 'center');
    btn = uibutton(leftPanel, 'Text', 'INITIALIZE SCAN', 'Position', [30 60 400 85], 'BackgroundColor', accentCyan, 'FontColor', [0 0 0], 'FontWeight', 'bold', 'FontSize', 22);

    % RIGHT Side: Decrypted Data Display
    rightPanel = uipanel(fig, 'Title', 'SECURE DATASET', 'Position', [530 40 480 580], 'BackgroundColor', panelBg, 'ForegroundColor', accentCyan, 'FontWeight', 'bold');
    labels = {'Full Owner Name', 'Exterior Color', 'Engine Number', 'Chassis Number', 'Tax Status', 'Tax Paid Until', ...
              'Vehicle Make', 'Vehicle Model', 'Manufacturer', 'Capacity', 'Body Type', 'Power', 'Class', 'CPLC Status'};
    displays = cell(1, length(labels));

    for i = 1:length(labels)
        yPos = 530 - (i*36);
        uipanel(rightPanel, 'Position', [20 yPos-3 440 1], 'BackgroundColor', [0.2 0.25 0.35], 'BorderType', 'none');
        uilabel(rightPanel, 'Text', labels{i}, 'Position', [25 yPos 180 22], 'FontColor', textGrey, 'FontSize', 11);
        displays{i} = uilabel(rightPanel, 'Text', '---', 'Position', [210 yPos 250 22], 'FontColor', [1 1 1], 'FontSize', 12, 'FontWeight', 'bold');
    end

    btn.ButtonPushedFcn = @(btn, event) runRecognition(btn, searchField, plates, data, displays, ax, fig);
end

function runRecognition(btn, searchField, plates, data, displays, ax, fig)
    btn.Text = 'SCANNING...';
    btn.BackgroundColor = [1 1 1];
    pause(0.6);
    
    input = upper(strtrim(searchField.Value));
    idx = find(strcmp(plates, input));

    if isempty(idx)
        uialert(fig, 'ACCESS DENIED: Plate not found in regional registry.', 'Registry Error');
        btn.Text = 'INITIALIZE SCAN';
        btn.BackgroundColor = [0.00 1.00 0.80];
    else
        res = data(idx);
        vals = {res.Owner, res.Color, res.EngineNo, res.ChassisNo, res.TaxStatus, res.TaxYear, ...
                res.Make, res.Model, res.Company, res.Capacity, res.BodyType, res.HorsePower, res.Class, res.CPLC};
        
        for k = 1:length(displays)
            displays{k}.Text = upper(vals{k});
        end
        
        % STOLEN ALERT LOGIC (Assigned to Plate 10)
        if contains(upper(res.CPLC), 'STOLEN')
            displays{14}.FontColor = [1 0 0]; 
            uialert(fig, 'CRITICAL ALERT: This vehicle is reported STOLEN. FIR has been lodged.', 'SECURITY ALERT', 'Icon', 'error');
        else
            displays{14}.FontColor = [1 1 1];
        end

        % TAX COLOR LOGIC
        if strcmpi(res.TaxStatus, 'Paid')
            displays{5}.FontColor = [0 1 0]; 
        else
            displays{5}.FontColor = [1 0.2 0.2];
        end

        % Display Image Logic
        try
            imgName = sprintf('plate%d.jpg', idx);
            img = imread(imgName);
            imshow(img, 'Parent', ax);
            title(ax, ['SCAN SUCCESS: ' input], 'Color', [0 1 0.8]);
        catch
            cla(ax);
            text(ax, 0.5, 0.5, 'NO SOURCE IMAGE', 'Color', [1 0 0], 'HorizontalAlignment', 'center');
        end
        
        btn.Text = 'SCAN COMPLETE';
        pause(1.0);
        btn.Text = 'INITIALIZE SCAN';
        btn.BackgroundColor = [0.00 1.00 0.80];
    end
end
