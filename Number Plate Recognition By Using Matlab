                      'UNKNOWN', 'Paid', 'Paid', 'PENDING', 'PENDING'}, ...
        'TaxYear', {'2026', '2026', '2023', '2025', '2022', ...
                    'N/A', '2027', '2026', '2020', '2017'}, ...
        'Make', {'Toyota', 'Suzuki', 'Suzuki', 'Suzuki', 'KIA', ...
                 'UNKNOWN', 'Honda', 'Toyota', 'MAKE', 'Toyota'}, ...
        'Model', {'Corolla', 'Mehran', 'Alto', 'Swift', 'Sportage', ...
                  'UNKNOWN', 'Civic', 'Yaris', 'MODEL', 'Land Crusier'}, ...
        'Company', {'Indus Motors', 'Suzuki Pak', 'Suzuki Pak', 'Hyundai Pak', 'Lucky Motors', ...
                    'UNKNOWN', 'Honda Atlas', 'Indus Motors', 'COMPANY', 'Toyota Motors'}, ...
        'Capacity', {'5', '5', '4', '5', '5', ...
                     '?', '5', '5', '?', '7'}, ...
        'BodyType', {'Sedan', 'Hatchback', 'Hatchback', 'Hatchback', 'SUV', ...
                     'UNKNOWN', 'Sedan', 'Sedan', 'TYPE', '5 Door SUV'}, ...
        'HorsePower', {'1300cc', '1000cc', '660cc', '1200cc', '2000cc', ...
                       'UNKNOWN', '1500cc', '1300cc', '000cc', '2500cc'}, ...
        'Class', {'M1', 'M1', 'A1', 'M1', 'SUV', ...
                  'UNKNOWN', 'M1', 'M1', 'CLASS', 'SUV'}, ...
